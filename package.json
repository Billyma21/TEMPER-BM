{
  "name": "temper",
  "version": "0.1.0",
  "private": true,
  "description": "TEMPER : le système de gestion intégré de la chocolaterie (RH, badges, pointage, production, qualité, stock, outils, ventes, finance) avec interface classique et monde 3D.",
  "author": "MAAYOUD",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "demo": "turbo run build --filter=@temper/permissions --filter=@temper/shared && pnpm --filter @temper/web demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @temper/db generate",
    "db:migrate": "pnpm --filter @temper/db migrate:dev",
    "db:seed": "pnpm --filter @temper/db seed",
    "db:studio": "pnpm --filter @temper/db studio",
    "docs:matrix": "pnpm --filter @temper/permissions matrix",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,css}\"",
    "check": "node scripts/check-deliverables.mjs",
    "e2e": "playwright test",
    "captures": "node scripts/captures.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@nestjs/core",
      "@swc/core"
    ]
  }
}
