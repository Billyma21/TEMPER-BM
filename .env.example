# ---------- Base de données ----------
DATABASE_URL="postgresql://temper:temper@localhost:5432/temper?schema=public"

# ---------- Cache, sessions, files d'attente ----------
REDIS_URL="redis://localhost:6379"

# ---------- Stockage objets (documents, photos, preuves de livraison) ----------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-1"
S3_BUCKET="temper"
S3_ACCESS_KEY="temper"
S3_SECRET_KEY="temper-secret"

# ---------- API ----------
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
# 64 octets aléatoires en base64 : openssl rand -base64 64
SESSION_SECRET="a-remplacer"
# Clé de chiffrement des champs sensibles (AES-256-GCM, 32 octets base64)
FIELD_ENCRYPTION_KEY="a-remplacer"
# Sel du hachage des identifiants de badge (HMAC-SHA256)
BADGE_UID_PEPPER="a-remplacer"
# Développement uniquement : considère le second facteur comme validé (refusé en production)
AUTH_DEV_MFA_BYPASS=true

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"

# ---------- E-mails ----------
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="TEMPER <no-reply@maison-aurum.test>"

# ---------- SSO (optionnel) ----------
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""

# ---------- Intégrations (laisser vide en dev, adaptateurs simulés) ----------
PEPPOL_ACCESS_POINT_URL=""
PEPPOL_API_KEY=""
PAYROLL_PROVIDER="mock"          # mock | sdworx | securex | partena | acerta
ACCOUNTING_PROVIDER="mock"       # mock | exact | yuki | odoo
